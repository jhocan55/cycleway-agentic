# Copy to .env and fill in your Langfuse API keys
# Get keys from: http://localhost:3000 → Settings → API Keys

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional: GitHub Models free inference (GPT-4o mini, Llama 3.3 70b)
# Get token from: https://github.com/settings/tokens (read:packages scope)
GITHUB_TOKEN=
